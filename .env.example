# Copy to .env (git-ignored) and fill in. Never commit real values.
# Generate a key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=sqlite:///todo.db

# Google OAuth client (type "Web application") from Google Cloud Console.
# Authorized redirect URI for local development: http://localhost:5000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: only allow these email domains (comma-separated). Empty = any Google account.
ALLOWED_EMAIL_DOMAINS=

# Local development over plain http only. Keep the default (true) everywhere else.
SESSION_COOKIE_SECURE=false
