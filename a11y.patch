diff --git a/static/app.css b/static/app.css
index f13265a..74bd0ad 100644
--- a/static/app.css
+++ b/static/app.css
@@ -11,3 +11,15 @@ input, select, button { padding: .6rem; }
 .priority { font-weight: bold; min-width: 2.5rem; }
 .flash { color: #a00; }
 .hint { color: #666; }
+
+/* Accessibility and layout pass */
+label { font-weight: 600; }
+form.stacked { flex-direction: column; align-items: stretch; max-width: 320px; }
+.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+:focus-visible { outline: 3px solid #2563eb; outline-offset: 2px; }
+@media (max-width: 480px) {
+  form.add { flex-wrap: wrap; }
+  form.add input { flex: 1 1 100%; }
+  .todos li { flex-wrap: wrap; }
+  .todos li form { margin-left: 0; }
+}
